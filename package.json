{
  "name": "maes17-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "build:client": "vite build --outDir dist/client",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "images": "node scripts/optimize-images.mjs",
    "brand": "node scripts/build-brand.mjs",
    "art": "node scripts/generate-art.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-armenian": "^5.3.0",
    "@fontsource-variable/noto-serif-armenian": "^5.3.0",
    "@fontsource-variable/noto-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "i18next": "^26.5.5",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.2",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
