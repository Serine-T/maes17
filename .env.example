# Public origin of the production site, without a trailing slash (optional).
# Used for canonical URLs, hreflang, the sitemap, Open Graph and JSON-LD.
#
# If it is not set, the origin is resolved dynamically:
#   - at build time from the hosting platform (Vercel, Netlify, Cloudflare Pages, Render, Railway);
#   - otherwise per request by `npm start` (the domain the visitor used) and in the browser.
# Set it explicitly when deploying to a plain static host (S3, GitHub Pages, nginx without Node).
# VITE_SITE_URL=https://www.example.com

# Runtime options for `npm start`:
# PORT=4173
# ALLOWED_HOSTS=maes17.am,www.maes17.am   # recommended in production
# TRUST_PROXY=1                            # behind nginx / a load balancer
